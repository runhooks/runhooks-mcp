{
  "name": "@runhooks/mcp",
  "version": "0.1.3",
  "mcpName": "io.github.runhooks/runhooks-mcp",
  "description": "Model Context Protocol server for Runhooks — let AI agents schedule and manage HTTP webhooks",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "runhooks-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "homepage": "https://runhooks.app/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runhooks/runhooks-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/runhooks/runhooks-mcp/issues"
  },
  "keywords": [
    "mcp",
